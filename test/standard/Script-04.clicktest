%script
click CONFIG

%file CONFIG
s0 :: Script(
   print $(add 1 2 3),
   print $(avg 1 2 3),
   print $(count 1 0 3),
   print $(popcount 1 0 3),
   print $(popcount .01 0.32 0),
   print $(sub 10 2 2),
   print $(min 10 6 20),
   print $(max -1 6 3),
   print $(mul 1 2 3),
   print $(div 75 2.5 5),
   print $(idiv 60 2 5),
   print $(htonl $(ntohl 6)),
   print $(htons $(ntohs 6)),
   write set foovar foo bar baz,
   print $(shift foovar),
   print $(shift foovar),
   print $(get foovar),
   print $(gt_vec 0 0.01 0.32 0),
   print $(gt_vec 0.02 0.01 0.32 0),
   print $(get_vec 2 0 2 7),
   print $(get_vec 1 0.5 1.5 2.5),
   print $(get_vec 3 1 2),
   print $(ceil 17.35),
   print $(floor 17.33),
   print $(round 17.33),
   print $(round 17.51),
   stop)

%expect stdout

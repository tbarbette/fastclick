%info
AggregateIPFlows pulled: a pulled batch whose packets all go to output 1
(not TCP or UDP) returns nothing, and is not emitted on output 0 too.

%require -q
click-buildtool provides FromIPSummaryDump

%script

click -e "
FromIPSummaryDump(IN1, STOP true, ZERO true)
	-> SetTimestamp
	-> Queue(100)
	-> a::AggregateIPFlows
	-> u::Unqueue(BURST 2, ACTIVE false)
	-> ToIPSummaryDump(OUT1, FIELDS aggregate ip_id);
a[1] -> ToIPSummaryDump(OUT2, FIELDS ip_id);
DriverManager(pause, write u.active true, wait 0.1s, stop)
"

%file IN1
!data src sport dst dport proto ip_id ip_fragoff ip_len
18.26.4.44 0 10.0.0.4 0 I 1 0 100
18.26.4.44 0 10.0.0.4 0 I 2 0 100
18.26.4.44 30 10.0.0.4 40 U 3 0 100
10.0.0.4 40 18.26.4.44 30 U 4 0 100
18.26.4.44 0 10.0.0.4 0 I 5 0 100
18.26.4.44 0 10.0.0.4 0 I 6 0 100
18.26.4.44 30 18.26.4.44 41 U 7 0 100
18.26.4.44 0 10.0.0.4 0 I 8 0 100

%expect OUT1
1 3
1 4
2 7

%expect OUT2
1
2
5
6
8

%ignorex
!.*

%eof
